<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of the old heart points widget (hidden, V2) (2×2: big circle + pace). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/hb_widget_preview_rings_bg" android:orientation="vertical" android:padding="14dp"
    android:gravity="center_horizontal">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Heart points"
        android:textColor="@color/hb_ring_zone" android:textSize="13sp" android:textStyle="bold" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
            android:src="@drawable/hb_preview_cardio_ring" android:scaleType="fitCenter" android:contentDescription="@null" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="96" android:textColor="@color/hb_widget_text" android:textSize="24sp" android:textStyle="bold" />
    </FrameLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="▲" android:textColor="@color/hb_widget_muted" android:textSize="11sp" />
</LinearLayout>
