<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of "Health BB · Workouts". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/hb_widget_preview_rings_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Workouts"
        android:textColor="@color/hb_widget_text" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="45 min today" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="3 / 5 active days" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Strength 3 · Cycling 2 · Walk 1" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
</LinearLayout>
