<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of "Health BB · Widget 2 / 3" (static; the live widget shows that slot's layout arranged in the app). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/hb_widget_preview_bg" android:orientation="vertical" android:padding="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:orientation="horizontal">
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:background="@drawable/hb_widget_preview_card" android:padding="12dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/hb_preview_rings" android:scaleType="fitCenter" android:contentDescription="@null" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:background="@drawable/hb_widget_preview_card" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight"
                android:textColor="@color/hb_widget_muted" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="86.4 kg"
                android:textColor="@color/hb_widget_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:layout_margin="4dp" android:background="@drawable/hb_widget_preview_card" android:orientation="vertical" android:padding="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sleep"
                android:textColor="@color/hb_widget_muted" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7h 20m"
                android:textColor="@color/hb_widget_text" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
