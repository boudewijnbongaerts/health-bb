<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of "Health BB · Clock" (V2): rings and clock side by side as one centred group, clear background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center" android:padding="8dp">
    <ImageView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="44"
        android:src="@drawable/hb_preview_rings" android:scaleType="fitCenter" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="56"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:42"
            android:fontFamily="sans-serif-light" android:includeFontPadding="false"
            android:textColor="#FFFFFFFF" android:textSize="44sp" android:shadowColor="#66000000" android:shadowRadius="6" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tue 3 Nov"
            android:textColor="#F2FFFFFF" android:textSize="13sp" android:shadowColor="#66000000" android:shadowRadius="5" />
    </LinearLayout>
</LinearLayout>
