<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview of "Recent workouts". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/hb_widget_preview_rings_bg" android:orientation="vertical" android:padding="14dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recent workouts"
        android:textColor="@color/hb_widget_text" android:textSize="13sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:text="Strength · 52 min · Today" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Cycling · 35 min · Yesterday" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Walking · 41 min · Wed" android:textColor="@color/hb_widget_text" android:textSize="12sp" />
</LinearLayout>
